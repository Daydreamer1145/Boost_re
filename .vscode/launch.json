{
    "version": "0.2.0",
    "configurations": [
        {
             "name": "CMSIS-DAP: 下载并调试 STM32F407",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Build Debug firmware",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Boost_re.elf",
            "gdbPath": "${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
            "servertype": "openocd",
            "serverpath": "D:/OpenOCD/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "interface": "swd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 4000"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}
